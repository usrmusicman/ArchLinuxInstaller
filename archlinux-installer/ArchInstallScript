#!/bin/env bash

# Define the config file path
CONFIG_FILE="Archlinux_Setup.conf"

# Check if the config file exists
if [[ -f "$CONFIG_FILE" ]]; then
    echo "Loading configuration from $CONFIG_FILE..."
    source "./$CONFIG_FILE"
else
    echo "Error: Configuration file '$CONFIG_FILE' not found!"
    echo "Please create it or ensure it's in the same directory."
    exit 1
fi

# Validation: Ensure critical variables aren't empty
: "${INSTALL_DISK:?Variable not set}"
: "${BOOT_PARTITION:?Variable not set}"
: "${OS_NAME:?Variable not set}"
: "${ROOT_PARTITION:?Variable not set}"
: "${USERNAME:?Variable not set}"

add_user() {

    echo "Add User..."

    # Add the user first
    arch-chroot "$CHROOT_DIR" useradd -m -G wheel -s /bin/bash "$USERNAME"

    # Create the specific gaming directories
    local USER_HOME="$CHROOT_DIR/home/$USERNAME"
    mkdir -p "$USER_HOME/.local/share/Steam"
    mkdir -p "$USER_HOME/.wine"
    mkdir -p "$USER_HOME/Games"

    # Enable casefold (+F) on the EMPTY directories
    # Note: Directories MUST be empty for this attribute to be set
    chattr +F "$USER_HOME/.local/share/Steam"
    chattr +F "$USER_HOME/.wine"
    chattr +F "$USER_HOME/Games"

    # Enable sudo
    echo '%wheel ALL=(ALL:ALL) ALL' > "$CHROOT_DIR/etc/sudoers.d/0-wheel"
    chmod 440 "$CHROOT_DIR/etc/sudoers.d/0-wheel"

    # Ensure the user actually owns their home folder after we made root-owned subdirs
    arch-chroot "$CHROOT_DIR" chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

}

configure_hostname() {

    echo "Configure Compter Name..."

    echo "$HOSTNAME" > "$CHROOT_DIR"/etc/hostname

}

configure_keyboard() {

    echo "Setting keyboard layout to: $KEYMAP"

    # 1. Set the layout for the CURRENT live session immediately
    loadkeys "$KEYMAP"

    # 2. Write to /etc/vconsole.conf for the installed system
    # This affects the TTY terminals
    echo "KEYMAP=$KEYMAP" > "$CHROOT_DIR/etc/vconsole.conf"

    # 3. Optional: Set a matching X11 layout for the GUI
    # While Plasma manages this itself, setting a system-wide default
    # prevents the login screen (SDDM) from defaulting to 'us'.
    local X11_LAYOUT
    case "$KEYMAP" in
        uk) X11_LAYOUT="gb" ;;
        ca-fr) X11_LAYOUT="ca" ;;
        *) X11_LAYOUT="$KEYMAP" ;;
    esac

    mkdir -p $CHROOT_DIR/etc/X11/xorg.conf.d/
    cat <<EOF > "$CHROOT_DIR/etc/X11/xorg.conf.d/00-keyboard.conf"
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "$X11_LAYOUT"
EndSection
EOF

}

configure_locale() {

    echo "Configure System Locale..."

    # Set fallback if input is empty
    if [[ -z "$USER_LOCALE" ]]; then
        USER_LOCALE="en_US.UTF-8"
    fi

    echo "Setting system locale to: $USER_LOCALE"

    # 1. Uncomment the chosen locale in locale.gen
    # We use escaped variables to ensure sed finds the exact line
    if grep -q "^#$USER_LOCALE" "$CHROOT_DIR/etc/locale.gen"; then
        sed -i "/^#$USER_LOCALE/s/^#//" "$CHROOT_DIR/etc/locale.gen"
    else
        echo "!! Warning: $USER_LOCALE not found in locale.gen. Falling back to en_US.UTF-8."
        USER_LOCALE="en_US.UTF-8"
        sed -i "/^#en_US.UTF-8 UTF-8/s/^#//" "$CHROOT_DIR/etc/locale.gen"
    fi

    # 2. Always ensure en_US.UTF-8 is generated as a secondary fallback for software compatibility
    if [[ "$USER_LOCALE" != "en_US.UTF-8" ]]; then
        sed -i "/^#en_US.UTF-8 UTF-8/s/^#//" "$CHROOT_DIR/etc/locale.gen"
    fi

    # 3. Generate and write config
    arch-chroot "$CHROOT_DIR" locale-gen
    echo "LANG=$USER_LOCALE" > "$CHROOT_DIR/etc/locale.conf"

    echo "Locale set successfully."

}

configure_mirrors() {

    echo "Optimizing mirrorlist for $MIRROR_COUNTRY..."

    # Ensure reflector is available on the live ISO
    if ! command -v reflector &> /dev/null; then
        pacman -Sy --noconfirm reflector
    fi

    # Run reflector using the country variable
    # --country: Filters by the code you entered
    # --protocol https: For security
    # --latest 20: Looks at the 20 most recently synced
    # --sort rate: Picks the fastest among them
    reflector --country "$MIRROR_COUNTRY" --age 12 --protocol https --latest 20 --number 5 --sort rate --save /etc/pacman.d/mirrorlist

}

configure_mkinitcpio() {

    echo "Creating mkinitcpio drop-in configurations..."

    mkdir -p "$CHROOT_DIR/etc/mkinitcpio.conf.d"

    # Nvidia Early KMS Modules
    # This ONLY creates the file if nvidia or nvidia_foss is detected in your config
    if [[ "$GPU0" =~ ^nvidia || "$GPU1" =~ ^nvidia ]]; then
        echo "Nvidia detected ($GPU0/$GPU1). Adding Early KMS modules..."
        cat <<EOF > "$CHROOT_DIR/etc/mkinitcpio.conf.d/10-nvidia.conf"
# Ensure the GPU initializes before the display manager starts
MODULES+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
EOF
    else
        echo "No Nvidia GPU detected. Skipping nvidia.conf..."
    fi

}

configure_mkinitcpio_uki_preset() {

    echo "Setting up mkinitcpio UKI preset..."

    local PRESET_FILE="$CHROOT_DIR/etc/mkinitcpio.d/${KERNEL}.preset"
    local EFI_DIR="/$BOOTLOADER_PATH/EFI/Linux"

    mkdir -p "${CHROOT_DIR}${EFI_DIR}"

    cat <<EOF > "$PRESET_FILE"
# mkinitcpio preset for ${KERNEL} to generate UKI only
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-${KERNEL}"

PRESETS=('default')

# We disable the standard .img generation to save space/time
# default_image="/boot/initramfs-${KERNEL}.img"

# Generate the UKI (.efi) directly
default_uki="$EFI_DIR/${KERNEL}.efi"
default_options="--cmdline /etc/kernel/cmdline"
EOF

}

configure_ntp() {

    echo "Enabling Network Time Synchronization (NTP)..."

    # Enable systemd-timesyncd
    # This is much lighter than chrony or ntpd for a gaming/workstation build
    arch-chroot "$CHROOT_DIR" systemctl enable systemd-timesyncd.service

}

configure_pacman_makepkg() {

    echo "Tuning Pacman and Makepkg configurations..."

    # 1. Enable Multilib in pacman.conf
    # This finds the [multilib] section header and the following Include line and uncomments them
    sed -i '/#\[multilib\]/,/#Include = \/etc\/pacman.d\/mirrorlist/ s/^#//' "$CHROOT_DIR/etc/pacman.conf"
    sed -i 's/^#ParallelDownloads = 5/ParallelDownloads = 10/' "$CHROOT_DIR/etc/pacman.conf"

    # 2. Disable Debugging in makepkg.conf
    # This finds the OPTIONS array and replaces 'debug' with '!debug'
    # It also ensures 'strip' is present to keep binary sizes down
    sed -i "s/OPTIONS=(/OPTIONS=(!debug /" "$CHROOT_DIR/etc/makepkg.conf"

    # Optional: Enable parallel compilation based on CPU cores (good for AUR builds)
    local CORES=$(nproc)
    sed -i "s/#MAKEFLAGS=\"-j2\"/MAKEFLAGS=\"-j$CORES\"/" "$CHROOT_DIR/etc/makepkg.conf"
    sed -i 's/COMPRESSZST=(zstd -c -z -q -)/COMPRESSZST=(zstd -c -z -q --threads=0 -)/' "$CHROOT_DIR/etc/makepkg.conf"

}

configure_timezone() {

    echo "Configure Timezone..."

    # Use fallback if global variable is empty
    local FINAL_ZONE=${TIMEZONE:-"UTC"}

    if [ -f "$CHROOT_DIR/usr/share/zoneinfo/$FINAL_ZONE" ]; then
        echo "Setting timezone to: $FINAL_ZONE"
        # Create the symlink for the timezone
        arch-chroot "$CHROOT_DIR" ln -sf "/usr/share/zoneinfo/$FINAL_ZONE" /etc/localtime

        # Update the hardware clock
        arch-chroot "$CHROOT_DIR" hwclock --systohc
    else
        echo "!! Error: Timezone $FINAL_ZONE not found. Defaulting to UTC."
        arch-chroot "$CHROOT_DIR" ln -sf /usr/share/zoneinfo/UTC /etc/localtime
    fi

}

create_partitions() {

    echo "Formatting Partitions..."

    # Format Boot (FAT32 for EFI)
    # -I ignores the 'is already a filesystem' prompt if it was previously formatted
    mkfs.vfat -F32 -I "$BOOT_PARTITION"

    # Format Root (EXT4 with Casefold)
    # Adding -F to force format without interaction
    mkfs.ext4 -F -b 4096 -E lazy_itable_init=1 -O casefold -m 1 "$ROOT_PARTITION"
    e2label "$ROOT_PARTITION" "$OS_NAME"

}

disable_heavy_services() {

    echo "Masking unneeded services (The Nuclear Option)..."
    # We use mask instead of disable to prevent these from being
    # started as dependencies by other packages.
    local SERVICES=(
        "systemd-networkd.service"
        "systemd-networkd.socket"
        "systemd-homed.service"
        "systemd-userdbd.socket"
        "systemd-journal-remote.service"
        "systemd-journal-upload.service"
        "systemd-journal-gatewayd.service"
        "systemd-pcrlock.service"
    )

    for svc in "${SERVICES[@]}"; do
        arch-chroot "$CHROOT_DIR" systemctl mask "$svc" >/dev/null 2>&1 || true
    done

}

enter_chroot() {

    # Enter newly installed system chroot environment
    arch-chroot "$CHROOT_DIR"

}

finalize_uki() {

    echo "Generating Unified Kernel Image (UKI) via mkinitcpio..."

    # Remove the default images if they were created during pacstrap
    rm -f "$CHROOT_DIR"/boot/initramfs-${KERNEL}.img
    rm -f "$CHROOT_DIR"/boot/initramfs-${KERNEL}-fallback.img

    # Build only what is in our new preset (the UKI)
    arch-chroot "$CHROOT_DIR" mkinitcpio -p ${KERNEL}

}

install_cpu_firmware() {

    echo "Install CPU Firmware..."

    # Install CPU firmware
    if [[ "$CPU" == "amd" ]]; then
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm amd-ucode
    elif [[ "$CPU" == "intel" ]]; then
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm intel-ucode
    else
        echo "No CPU Detected"
    fi

}

install_gpu_driver() {

    # Update System
    arch-chroot "$CHROOT_DIR" pacman -Sy

    if [[ "$GPU0" == "amd" ]] || [[ "$GPU1" == "amd" ]]; then

        # AMD GPU
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm libva-utils opencl-mesa rocm-hip-runtime rocm-opencl-runtime rocminfo vulkan-mesa-implicit-layers vulkan-mesa-layers vulkan-radeon

        # AMD GPU (32-bit)
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm lib32-vulkan-mesa-implicit-layers lib32-vulkan-mesa-layers lib32-opencl-mesa lib32-vulkan-radeon

    elif [[ "$GPU0" == "intel" ]] || [[ "$GPU1" == "intel" ]]; then

        # Intel GPU
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm intel-compute-runtime intel-media-driver libva-utils vpl-gpu-rt vulkan-intel vulkan-mesa-implicit-layers vulkan-mesa-layers

        # Intel GPU (32-bit)
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm lib32-vulkan-mesa-implicit-layers lib32-vulkan-mesa-layers lib32-vulkan-intel

    elif [[ "$GPU0" == "nvidia" ]] || [[ "$GPU1" == "nvidia" ]]; then

        # Nvidia GPU
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm libnvidia-container libva-nvidia-driver libvdpau-va-gl nvidia-open-dkms nvidia-prime nvidia-settings nvidia-container-toolkit nvidia-utils nvtop opencl-nvidia vdpauinfo

        # Nvidia GPU (32-bit)
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm lib32-nvidia-utils lib32-opencl-nvidia

    elif [[ "$GPU0" == "nvidia_foss" ]] || [[ "$GPU1" == "nvidia_foss" ]]; then

        # Nvidia GPU FOSS
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm opencl-mesa vulkan-mesa-implicit-layers vulkan-mesa-layers vulkan-nouveau

        # Nvidia GPU FOSS (32-bit)
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm lib32-opencl-mesa lib32-vulkan-mesa-implicit-layers lib32-vulkan-mesa-layers lib32-vulkan-nouveau

    else

        echo "No GPU Detected...."

    fi

}

generate_fstab() {

    echo "Install FSTAB..."

    # Generate FSTAB
    genfstab -U "$CHROOT_DIR" > "$CHROOT_DIR"/etc/fstab

}

mount_partitions() {

    echo "Mount Partitions..."

    # Ensure the directory exists first
    mkdir -p "$CHROOT_DIR"

    # Mount Root
    mount -t ext4 -o noatime,commit=10,lazytime "$ROOT_PARTITION" "$CHROOT_DIR"

    # Mount Boot
    mkdir -p "$CHROOT_DIR/$BOOTLOADER_PATH"
    mount "$BOOT_PARTITION" "$CHROOT_DIR/$BOOTLOADER_PATH"

}

partition_disk() {

    echo "Verifying partitions..."

    # Check if the physical disk exists
    if [[ ! -b "$INSTALL_DISK" ]]; then
        echo "Error: Device $INSTALL_DISK not found!"
        exit 1
    fi

    # Check if the partitions exist
    if [[ ! -b "$BOOT_PARTITION" ]] || [[ ! -b "$ROOT_PARTITION" ]]; then
        echo "Error: Partitions not found. Please partition the disk manually first."
        echo "Required: $BOOT_PARTITION and $ROOT_PARTITION"
        exit 1
    fi

    echo "Partitions verified. Proceeding to formatting..."

}

register_efistub() {

    echo "Registering UKI with UEFI Boot Manager..."

    # 1. Clean up old entries to avoid BIOS clutter
    # This finds the hex ID (e.g., 0001) for any entry labeled "Arch ${KERNEL}"
    local OLD_ENTRY=$(arch-chroot "$CHROOT_DIR" efibootmgr | grep "Arch ${KERNEL}" | head -n 1 | awk '{print $1}' | sed 's/Boot//;s/\*//')

    if [[ -n "$OLD_ENTRY" ]]; then
        echo "Removing old UEFI entry $OLD_ENTRY..."
        arch-chroot "$CHROOT_DIR" efibootmgr -b "$OLD_ENTRY" -B
    fi

    # 2. Identify the disk and partition
    local DISK=$(echo "$BOOT_PARTITION" | sed -E 's/p?[0-9]+$//')
    local PART=$(echo "$BOOT_PARTITION" | grep -oE '[0-9]+$')

    # 3. Create the new entry
    # Ensure the loader path uses double backslashes for UEFI compliance
    arch-chroot "$CHROOT_DIR" efibootmgr --create \
        --disk "$DISK" \
        --part "$PART" \
        --label "Arch ${KERNEL}" \
        --loader "\\EFI\\Linux\\${KERNEL}.efi" \
        --unicode

}

setup_archlinux() {

    # Setup welcome message
    echo "Setup Archlinux..."

    # Core packages to install
    pacstrap "$CHROOT_DIR" avahi binutils base base-devel curl dkms dosfstools e2fsprogs efibootmgr git less linux-firmware ${KERNEL} ${KERNEL}-headers man-db man-pages man-pages-utils mkinitcpio nss-mdns plymouth reflector wget zram-generator

    # Mirrorlist And Keys
    cp /etc/pacman.d/mirrorlist "$CHROOT_DIR"/etc/pacman.d/mirrorlist
    arch-chroot "$CHROOT_DIR" pacman-key --init
    arch-chroot "$CHROOT_DIR" pacman-key --populate archlinux

    # EFIStub Generator
    echo "Install efibootmgr efistub enhanced script"
    cp efistub_generator $CHROOT_DIR/usr/local/bin

    # Network Discovery
    arch-chroot "$CHROOT_DIR" systemctl enable avahi-daemon.service

    # Configure NSS Switch to use mdns_minimal
    sed -i 's/hosts: mymachines/hosts: mymachines mdns_minimal [NOTFOUND=return]/' "$CHROOT_DIR"/etc/nsswitch.conf

}

setup_base() {

    # Setup welcome message
    echo "Setup Base CLI Environment..."

    # Update System
    arch-chroot "$CHROOT_DIR" pacman -Sy

    # Install System Packages
    arch-chroot "$CHROOT_DIR" pacman -S --noconfirm 7zip bash-completion bluez bluez-cups bluez-hid2hci bluez-libs bluez-obex bluez-utils exfatprogs ffmpeg flatpak fwupd gst-libav gst-plugin-pipewire gst-plugins-bad gst-plugins-bad-libs gst-plugins-base gst-plugins-base-libs gst-plugins-espeak gst-plugins-good gst-plugins-ugly ifuse iproute2 irqbalance libcurl-compat libcurl-gnutls libdvdcss libgpod lsb-release networkmanager networkmanager-vpn-plugin-openvpn noto-fonts noto-fonts-cjk noto-fonts-emoji ntfs-3g openssh pipewire-alsa pipewire-audio pipewire-ffado pipewire-libcamera pipewire-pulse pipewire-session-manager pipewire-v4l2 power-profiles-daemon unrar unzip wiremix vi vim zip

    # Install System Packages (32-bit)
    arch-chroot "$CHROOT_DIR" pacman -S --noconfirm lib32-libcurl-compat lib32-libcurl-gnutls lib32-pipewire-v4l2 multilib-devel

    # Enable networking and bluetooth
    arch-chroot "$CHROOT_DIR" systemctl enable NetworkManager.service
    arch-chroot "$CHROOT_DIR" systemctl enable bluetooth.service

    # Add users to the appropriate groups
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME audio
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME flatpak
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME input
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME render
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME video

}

setup_chaotic_aur() {

    # Chaotic AUR
    if [[ "$USE_CHAOTIC" =~ ^[Yy]$ ]]; then
        echo "Installing Chaotic-AUR..."

        # 1. Receive the primary key
        CHAOTIC_KEYRING="3056513887B78AEB"
        arch-chroot "$CHROOT_DIR" pacman-key --recv-key $CHAOTIC_KEYRING --keyserver keyserver.ubuntu.com
        arch-chroot "$CHROOT_DIR" pacman-key --lsign-key $CHAOTIC_KEYRING

        # 2. Install the keyring and mirrorlist
        arch-chroot "$CHROOT_DIR" pacman -U --noconfirm 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst'
        arch-chroot "$CHROOT_DIR" pacman -U --noconfirm 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'

        # 3. Add to pacman.conf
        {
            echo ""
            echo "[chaotic-aur]"
            echo "Include = /etc/pacman.d/chaotic-mirrorlist"
        } >> "$CHROOT_DIR/etc/pacman.conf"

        # Intialize Chaotic Keyring
        pacman-key --populate chaotic

        # Refresh database
        arch-chroot "$CHROOT_DIR" pacman -Sy --noconfirm
    fi

}

setup_gaming_environment() {

    # Setup welcome message
    echo "Setup Gaming Environment..."

    # Update System
    arch-chroot "$CHROOT_DIR" pacman -Sy

    # Install Gaming Packages
    arch-chroot "$CHROOT_DIR" pacman -S --noconfirm gamemode gamescope mangohud openrgb steam steam-devices umu-launcher

    # Install GPU driver tunable frontends
    if [[ "$GPU0" == "amd" ]] || [[ "$GPU1" == "amd" ]]; then
        arch-chroot "$CHROOT_DIR" pacman -S --noconfirm lact
        arch-chroot "$CHROOT_DIR" systemctl enable --now lactd.service
    fi

    # Install Gaming Packages (32-bit)
    arch-chroot "$CHROOT_DIR" pacman -S --noconfirm lib32-gamemode lib32-mangohud

    # Add users to the appropriate groups
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME games

}

setup_kernel_cmdline() {

    # Setup welcome message
    echo "Setup Kernel Commandline..."

    # Get the UUID correctly
    local ROOT_UUID=$(blkid -s UUID -o value "$ROOT_PARTITION")

    # Create efi commandline params script
    echo "#!/bin/env bash" > "$CHROOT_DIR"/usr/local/bin/cmdline_config
    echo "export CMDLINE+=\"root=UUID=$ROOT_UUID rw zswap.enabled=0 quiet splash nowatchdog \"" >> "$CHROOT_DIR"/usr/local/bin/cmdline_config
    chmod +x "$CHROOT_DIR"/usr/local/bin/cmdline_config

    # Create efi commandline execution script
    echo "#!/bin/env bash" > "$CHROOT_DIR"/usr/local/bin/update_cmdline
    echo "source /usr/local/bin/cmdline_config" >> "$CHROOT_DIR"/usr/local/bin/update_cmdline
    echo "mkdir -p /etc/kernel" >> "$CHROOT_DIR"/usr/local/bin/update_cmdline
    echo "echo \"\$CMDLINE\" > /etc/kernel/cmdline" >> "$CHROOT_DIR"/usr/local/bin/update_cmdline
    chmod +x "$CHROOT_DIR"/usr/local/bin/update_cmdline

    # Launch the update_cmdline script
    arch-chroot "$CHROOT_DIR" /usr/local/bin/update_cmdline

}

setup_plasma_desktop() {

    # Setup welcome message
    echo "Setup Plasma Desktop..."

    # Update System
    arch-chroot "$CHROOT_DIR" pacman -Sy

    # Install Plasma Packages
    arch-chroot "$CHROOT_DIR" pacman -S --noconfirm ark breeze5 dolphin dolphin-plugins ffmpegthumbs firefox firefox-i18n-en-us gnome-keyring gwenview icoutils kaccounts-integration kate kcalc kdeconnect kdegraphics-mobipocket kdegraphics-thumbnailers kdialog keditbookmarks kio-admin kio-extras kio-fuse konsole ksshaskpass orca partitionmanager plymouth-kcm phonon-qt6-vlc plasma-meta vlc yt-dlp

    # Enable Plasma Login
    arch-chroot "$CHROOT_DIR" systemctl enable plasmalogin.service

    # Add users to the appropriate groups
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME plasmalogin

}

setup_printing_support() {

    # Setup welcome message
    echo "Setup Printing Support..."

    # Update System
    arch-chroot "$CHROOT_DIR" pacman -Sy

    # Install Printing Packages
    arch-chroot "$CHROOT_DIR" pacman -S --noconfirm cups cups-browsed system-config-printer

    # Enable printing services
    arch-chroot "$CHROOT_DIR" systemctl enable cups.service
    arch-chroot "$CHROOT_DIR" systemctl enable cups-browsed.service

    # Add users to the appropriate groups
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME cups

}

setup_pro_audio() {

    # Setup welcome message
    echo "Setup A Pro Audio Workstation Environment..."

    # Update System
    arch-chroot "$CHROOT_DIR" pacman -Sy

    # Force remove jack2 package
    arch-chroot "$CHROOT_DIR" pacman -Rdd --noconfirm jack2

    # Force remove jack2 package (32-bit)
    arch-chroot "$CHROOT_DIR" pacman -Rdd --noconfirm lib32-jack2

    # Install Pro Audio Packages
    arch-chroot "$CHROOT_DIR" pacman -S --noconfirm carla irqbalance pipewire-jack qpwgraph reapack reaper sws realtime-privileges

    # Install Pro Audio Packages (32-bit)
    arch-chroot "$CHROOT_DIR" pacman -S --noconfirm lib32-pipewire-jack

    # Performance & Audio
    arch-chroot "$CHROOT_DIR" systemctl enable irqbalance.service

    # Add users to the appropriate groups
    arch-chroot "$CHROOT_DIR" gpasswd -a $USERNAME realtime

    # Add a line to the cmdline configuration tool for the pro audio boot kernel options
    echo "export CMDLINE+=\"mitigations=off pcie_aspm=off threadirqs usbcore.autosuspend=-1 \"" >> "$CHROOT_DIR"/usr/local/bin/cmdline_config

    # Launch the update_cmdline script
    arch-chroot "$CHROOT_DIR" /usr/local/bin/update_cmdline

}

set_password() {

    # Create / change password for the created user
    arch-chroot "$CHROOT_DIR" passwd "$USERNAME"

}

unmount_system() {

    # Unmount the newly installed system
    umount -lf $CHROOT_DIR

}

zram_disk() {

    echo "Setup Zram..."

    # Install Zram Config
    cat <<EOF > "$CHROOT_DIR"/etc/systemd/zram-generator.conf
[zram0]
# Uses half of RAM, but caps it at 8GB (8192MB)
zram-size = min(ram / 2, 8192)
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF

}

if [[ "$USER" == "root" ]]; then

    if [[ "$1" == "--base" ]]; then
        clear
        install_gpu_driver
        setup_base
    elif [[ "$1" == "--core" ]]; then
        clear
        setup_archlinux
        setup_chaotic_aur
        configure_pacman_makepkg
        generate_fstab
        zram_disk
        install_cpu_firmware
        setup_kernel_cmdline
        configure_mkinitcpio
        configure_mkinitcpio_uki_preset
        configure_hostname
        configure_locale
        configure_keyboard
        configure_timezone
        configure_ntp
        finalize_uki
        register_efistub
        add_user
        echo "Installation Complete! You can now reboot into your new system."
    elif [[ "$1" == "--chroot" ]]; then
        clear
        echo -e "Entering the chroot environment...\n"
        enter_chroot
        clear
    elif [[ "$1" == "--gaming" ]]; then
        clear
        setup_gaming_environment
        echo "Installation Complete! You have installed the gaming environment."
    elif [[ "$1" == "--mount" ]]; then
        clear
        mount_partitions
        echo "Mount Successful! You have mounted the newly installed system."
    elif [[ "$1" == "--optimize" ]]; then
        disable_heavy_services
        echo "Installation Complete! You have optimized your system."
    elif [[ "$1" == "--plasma-desktop" ]]; then
        clear
        setup_plasma_desktop
        echo "Installation Complete! You have installed the Plasma desktop."
    elif [[ "$1" == "--prepare-system" ]]; then
        clear
        configure_mirrors
        partition_disk
        create_partitions
        mount_partitions
        echo "Preparation Complete! You are ready to install the new system."
    elif [[ "$1" == "--printing" ]]; then
        clear
        setup_printing_support
        echo "Installation Complete! You have installed printing support."
    elif [[ "$1" == "--pro-audio" ]]; then
        clear
        setup_pro_audio
        echo "Installation Complete! You have installed the pro audio environment."
    elif [[ "$1" == "--set-password" ]]; then
        clear
        set_password
        echo "Password Changed Successfully!"
    elif [[ "$1" == "--unmount" ]]; then
        clear
        unmount_system
        echo "Unmount Successful! You have unmounted the newly installed system."
    else
        echo "Archlinux System Installer"
        echo ""
        echo "Commandline Options"
        echo "--base: This is the base install for all use cases and acts as a CLI server."
        echo "--core: The most bare metal install. STEP 2 OF INSTALL!"
        echo "--chroot: Enter the newly installed system."
        echo "--gaming: Install and configure the gaming environment."
        echo "--prepare-system: Prepares the system for installation. STEP 1 OF INSTALL!"
        echo "--mount: Mount the newly installed system."
        echo "--optimize: Optimize your newly installed system."
        echo "--plasma-desktop: Install and configure the lateest KDE Plasma desktop environment."
        echo "--printing: Install and configure the cups printing server."
        echo "--pro-audio: Install and configure the pro-audio environment."
        echo "--set-password: Change password for the desired user. STEP 3 OF INSTALL!"
        echo "--unmount: Unmount the newly installed system."
        echo "If none of these switches are used then show this help message."
        echo ""
    fi

fi
